+/**
+ * Highlight the window title bar button under the cursor (window-actions).
+ */
+static void update_close_hover(struct sway_cursor *cursor,
+		struct sway_node *node, struct wlr_surface *surface) {
+	struct sway_container *cont = node && node->type == N_CONTAINER ?
+		node->sway_container : NULL;
+	enum sway_title_button button = TITLE_BUTTON_NONE;
+	if (cont && cont->view && !surface &&
+			find_edge(cont, surface, cursor) == WLR_EDGE_NONE) {
+		button = container_title_button_at(cont, cursor->cursor->x, cursor->cursor->y);
+	}
+	container_title_button_hover(cont, button);
+}
+
+static void title_button_action(struct sway_container *cont,
+		enum sway_title_button button) {
+	switch (button) {
+	case TITLE_BUTTON_CLOSE:
+		view_close(cont->view);
+		break;
+	case TITLE_BUTTON_MAXIMIZE:
+	case TITLE_BUTTON_RESTORE:
+		window_toggle_maximize(container_toplevel_ancestor(cont));
+		break;
+	case TITLE_BUTTON_MINIMIZE:
+		window_minimize(cont);
+		break;
+	case TITLE_BUTTON_NONE:
+		break;
+	}
+}
+
 /**
  * If the cursor is over a _resizable_ edge, return the edge.
  * Edges that can't be resized are edges of the workspace.
@@ -368,6 +402,57 @@ static void handle_button(struct sway_seat *seat, uint32_t time_msec,
 		return;
 	}
 
+	// Title bar buttons (close, maximize / restore, minimize): the action happens on release,
+	// if the press was on the same button too (like a button in an app). Neither the press nor the release
+	// goes to anyone else.
+	static size_t pressed_id = 0;
+	static enum sway_title_button pressed_button = TITLE_BUTTON_NONE;
+	if (button == BTN_LEFT) {
+		enum sway_title_button on_button = cont && cont->view && on_titlebar ?
+			container_title_button_at(cont, cursor->cursor->x, cursor->cursor->y) :
+			TITLE_BUTTON_NONE;
+		if (state == WL_POINTER_BUTTON_STATE_PRESSED && on_button != TITLE_BUTTON_NONE) {
+			pressed_id = cont->node.id;
+			pressed_button = on_button;
+			return;
+		}
+		if (state == WL_POINTER_BUTTON_STATE_RELEASED && pressed_id) {
+			size_t id = pressed_id;
+			enum sway_title_button pressed = pressed_button;
+			pressed_id = 0;
+			pressed_button = TITLE_BUTTON_NONE;
+			if (on_button == pressed && cont->node.id == id) {
+				title_button_action(cont, pressed);
+				transaction_commit_dirty();
+			}
+			return;
+		}
+	}
+
+	// Double-click on a floating window's title bar: maximize / restore (window-actions)
+	static size_t last_title_id = 0;
+	static uint32_t last_title_msec = 0;
+	static double last_title_x = 0, last_title_y = 0;
+	if (cont && on_titlebar && button == BTN_LEFT &&
+			state == WL_POINTER_BUTTON_STATE_PRESSED &&
+			is_floating_or_child && !is_fullscreen_or_child) {
+		struct sway_container *top = container_toplevel_ancestor(cont);
+		bool double_click = last_title_id == top->node.id &&
