diff --git a/sway/sway_close_node.c b/sway/sway_close_node.c
new file mode 100644
index 0000000..c81accc
--- /dev/null
+++ b/sway/sway_close_node.c
@@ -0,0 +1,230 @@
+// Title bar buttons (close, maximize / restore, minimize): a circle with a symbol
+// drawn with cairo into a scene buffer (like the title text in sway_text_node.c), so it
+// moves with the window without delay.
+#include <drm_fourcc.h>
+#include <math.h>
+#include <stdlib.h>
+#include <string.h>
+#include <cairo.h>
+#include <wlr/interfaces/wlr_buffer.h>
+#include <wlr/types/wlr_buffer.h>
+#include <wlr/types/wlr_output.h>
+#include "log.h"
+#include "sway/sway_close_node.h"
+
+#ifndef M_PI
+#define M_PI 3.14159265358979323846
+#endif
+
+struct close_cairo_buffer {
+	struct wlr_buffer base;
+	cairo_surface_t *surface;
+};
+
+static void close_cairo_buffer_destroy(struct wlr_buffer *wlr_buffer) {
+	struct close_cairo_buffer *buffer = wl_container_of(wlr_buffer, buffer, base);
+	cairo_surface_destroy(buffer->surface);
+	free(buffer);
+}
+
+static bool close_cairo_buffer_begin(struct wlr_buffer *wlr_buffer,
+		uint32_t flags, void **data, uint32_t *format, size_t *stride) {
+	struct close_cairo_buffer *buffer = wl_container_of(wlr_buffer, buffer, base);
+	*data = cairo_image_surface_get_data(buffer->surface);
+	*stride = cairo_image_surface_get_stride(buffer->surface);
+	*format = DRM_FORMAT_ARGB8888;
+	return true;
+}
+
+static void close_cairo_buffer_end(struct wlr_buffer *wlr_buffer) {
+}
+
+static const struct wlr_buffer_impl close_cairo_buffer_impl = {
+	.destroy = close_cairo_buffer_destroy,
+	.begin_data_ptr_access = close_cairo_buffer_begin,
+	.end_data_ptr_access = close_cairo_buffer_end,
+};
+
+struct close_buffer {
+	struct wlr_scene_buffer *buffer_node;
+	struct sway_close_node props;
+	bool visible;
+	float scale;
+
+	struct wl_listener outputs_update;
+	struct wl_listener destroy;
+};
+
+static void render(struct close_buffer *buffer) {
+	if (!buffer->visible || buffer->props.size <= 0) {
+		return;
+	}
+	float scale = buffer->scale > 0 ? buffer->scale : 1;
+	int px = ceil(buffer->props.size * scale);
+	float *c = buffer->props.color;
+	float *bg = buffer->props.background;
+
+	cairo_surface_t *surface = cairo_image_surface_create(CAIRO_FORMAT_ARGB32, px, px);
+	if (cairo_surface_status(surface) != CAIRO_STATUS_SUCCESS) {
+		sway_log(SWAY_ERROR, "close button: cairo_image_surface_create failed");
+		cairo_surface_destroy(surface);
+		return;
+	}
+	struct close_cairo_buffer *cb = calloc(1, sizeof(*cb));
+	if (!cb) {
+		cairo_surface_destroy(surface);
+		return;
+	}
+	cairo_t *cr = cairo_create(surface);
+	cairo_set_antialias(cr, CAIRO_ANTIALIAS_BEST);
+
+	// title bar background, circle, ✕
+	cairo_set_source_rgba(cr, bg[0], bg[1], bg[2], bg[3]);
+	cairo_paint(cr);
+	double r = px / 2.0;
+	cairo_arc(cr, r, r, r, 0, 2 * M_PI);
+	cairo_set_source_rgba(cr, c[0], c[1], c[2], c[3] * (buffer->props.hover ? 0.32 : 0.16));
+	cairo_fill(cr);
+	double d = px * 0.22;
+	double w = fmax(1.5, px * 0.085);
+	cairo_set_line_width(cr, w);
+	cairo_set_line_cap(cr, CAIRO_LINE_CAP_ROUND);
+	cairo_set_line_join(cr, CAIRO_LINE_JOIN_ROUND);
+	switch (buffer->props.type) {
+	case TITLE_BUTTON_CLOSE:
+		cairo_move_to(cr, r - d, r - d);
+		cairo_line_to(cr, r + d, r + d);
+		cairo_move_to(cr, r + d, r - d);
+		cairo_line_to(cr, r - d, r + d);
+		break;
+	case TITLE_BUTTON_MAXIMIZE:
+		cairo_rectangle(cr, r - d, r - d, 2 * d, 2 * d);
+		break;
+	case TITLE_BUTTON_RESTORE:;
+		// two overlapping squares: the front one bottom left, the back one top right (only its outline)
+		double s = d * 1.45, o = d * 0.55;
+		cairo_rectangle(cr, r - d, r - d + o, s, s);
+		cairo_move_to(cr, r - d + o, r - d + o);
+		cairo_line_to(cr, r - d + o, r - d);
+		cairo_line_to(cr, r + d, r - d);
+		cairo_line_to(cr, r + d, r - d + s);
+		cairo_line_to(cr, r - d + s, r - d + s);
+		break;
+	case TITLE_BUTTON_MINIMIZE:
+		cairo_move_to(cr, r - d, r + d * 0.6);
+		cairo_line_to(cr, r + d, r + d * 0.6);
+		break;
+	case TITLE_BUTTON_NONE:
+		break;
+	}
+	cairo_set_source_rgba(cr, c[0], c[1], c[2], c[3]);
+	cairo_stroke(cr);
+	cairo_destroy(cr);
+	cairo_surface_flush(surface);
+
+	wlr_buffer_init(&cb->base, &close_cairo_buffer_impl, px, px);
+	cb->surface = surface;
+	wlr_scene_buffer_set_buffer(buffer->buffer_node, &cb->base);
+	wlr_buffer_drop(&cb->base);
+	wlr_scene_buffer_set_dest_size(buffer->buffer_node, buffer->props.size, buffer->props.size);
+
+	pixman_region32_t opaque;
+	pixman_region32_init(&opaque);
+	if (bg[3] == 1) {
+		pixman_region32_union_rect(&opaque, &opaque, 0, 0,
+			buffer->props.size, buffer->props.size);
+	}
+	wlr_scene_buffer_set_opaque_region(buffer->buffer_node, &opaque);
+	pixman_region32_fini(&opaque);
+}
+
+static void handle_outputs_update(struct wl_listener *listener, void *data) {
+	struct close_buffer *buffer = wl_container_of(listener, buffer, outputs_update);
+	struct wlr_scene_outputs_update_event *event = data;
+	float scale = 0;
+	for (size_t i = 0; i < event->size; i++) {
+		if (scale < event->active[i]->output->scale) {
+			scale = event->active[i]->output->scale;
+		}
+	}
+	bool visible = event->size > 0;
+	bool changed = scale != buffer->scale || (visible && !buffer->visible);
+	buffer->visible = visible;
+	if (changed) {
+		buffer->scale = scale;
+		render(buffer);
+	}
+}
+
+static void handle_destroy(struct wl_listener *listener, void *data) {
+	struct close_buffer *buffer = wl_container_of(listener, buffer, destroy);
+	wl_list_remove(&buffer->outputs_update.link);
+	wl_list_remove(&buffer->destroy.link);
+	free(buffer);
+}
+
+struct sway_close_node *sway_close_node_create(struct wlr_scene_tree *parent,
+		enum sway_title_button type, int size, float color[4], float background[4]) {
+	struct close_buffer *buffer = calloc(1, sizeof(*buffer));
+	if (!buffer) {
+		return NULL;
+	}
+	struct wlr_scene_buffer *node = wlr_scene_buffer_create(parent, NULL);
+	if (!node) {
+		free(buffer);
+		return NULL;
+	}
+	buffer->buffer_node = node;
+	buffer->props.node = &node->node;
+	buffer->props.size = size;
+	buffer->props.type = type;
+	memcpy(buffer->props.color, color, sizeof(float) * 4);
+	memcpy(buffer->props.background, background, sizeof(float) * 4);
+	wlr_scene_buffer_set_dest_size(node, size, size);
+
+	buffer->destroy.notify = handle_destroy;
+	wl_signal_add(&node->node.events.destroy, &buffer->destroy);
+	buffer->outputs_update.notify = handle_outputs_update;
+	wl_signal_add(&node->events.outputs_update, &buffer->outputs_update);
+	return &buffer->props;
+}
+
+void sway_close_node_set_size(struct sway_close_node *node, int size) {
+	struct close_buffer *buffer = wl_container_of(node, buffer, props);
+	if (node->size == size) {
+		return;
+	}
+	node->size = size;
+	wlr_scene_buffer_set_dest_size(buffer->buffer_node, size, size);
+	render(buffer);
+}
+
+void sway_close_node_set_colors(struct sway_close_node *node,
+		float color[4], float background[4]) {
+	if (memcmp(node->color, color, sizeof(float) * 4) == 0 &&
+			memcmp(node->background, background, sizeof(float) * 4) == 0) {
+		return;
+	}
+	memcpy(node->color, color, sizeof(float) * 4);
+	memcpy(node->background, background, sizeof(float) * 4);
+	struct close_buffer *buffer = wl_container_of(node, buffer, props);
+	render(buffer);
+}
+
+void sway_close_node_set_hover(struct sway_close_node *node, bool hover) {
+	if (node->hover == hover) {
+		return;
+	}
+	node->hover = hover;
+	struct close_buffer *buffer = wl_container_of(node, buffer, props);
+	render(buffer);
+}
+
+void sway_close_node_set_type(struct sway_close_node *node, enum sway_title_button type) {
+	if (node->type == type) {
+		return;
+	}
+	node->type = type;
+	struct close_buffer *buffer = wl_container_of(node, buffer, props);
+	render(buffer);
+}
