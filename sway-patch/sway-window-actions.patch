diff --git a/sway/window_actions.c b/sway/window_actions.c
new file mode 100644
index 0000000..d57b2dd
--- /dev/null
+++ b/sway/window_actions.c
@@ -0,0 +1,304 @@
+// window-actions: maximize, edge snapping and minimize for floating windows.
+//
+// All paths lead here: title bar buttons, double-click on the title bar, buttons in the title bars
+// of apps (xdg_toplevel set_maximized / set_minimized), the `maximize` and `minimize` commands
+// and dragging a window to the screen edge (seatop_move_floating.c).
+//
+// A maximized or snapped window remembers its original geometry (relative to the workspace) and gets it back
+// by restoring, double-clicking or dragging away. Minimizing = scratchpad; the window remembers its workspace
+// (and whether it was tiled) and root_scratchpad_show puts it back there.
+#include <math.h>
+#include <sys/param.h>
+#include <stdlib.h>
+#include <string.h>
+#include <wlr/config.h>
+#include <wlr/types/wlr_output_layout.h>
+#include <wlr/types/wlr_scene.h>
+#include <wlr/types/wlr_xdg_shell.h>
+#include <wlr/util/edges.h>
+#if WLR_HAS_XWAYLAND
+#include <wlr/xwayland.h>
+#endif
+#include "sway/config.h"
+#include "sway/ipc-server.h"
+#include "sway/window_actions.h"
+#include "sway/output.h"
+#include "sway/tree/arrange.h"
+#include "sway/tree/container.h"
+#include "sway/tree/root.h"
+#include "sway/tree/view.h"
+#include "sway/tree/workspace.h"
+
+// how close to the screen edge the cursor must be to snap the window
+#define EDGE 2
+
+// Tells the app it's maximized / snapped: it then draws square corners without a shadow
+// and the maximize button as “restore”.
+static void set_client_state(struct sway_container *con, enum window_snap_side snap) {
+	struct sway_view *view = con->view;
+	if (!view) {
+		return;
+	}
+	bool max = snap == WINDOW_SNAP_MAX;
+	switch (view->type) {
+	case SWAY_VIEW_XDG_SHELL: {
+		struct wlr_xdg_toplevel *toplevel = view->wlr_xdg_toplevel;
+		if (!toplevel || !toplevel->base->initialized) {
+			break;
+		}
+		wlr_xdg_toplevel_set_maximized(toplevel, max);
+		if (wl_resource_get_version(toplevel->resource) >=
+				XDG_TOPLEVEL_STATE_TILED_LEFT_SINCE_VERSION) {
+			enum wlr_edges edges = WLR_EDGE_NONE;
+			if (snap == WINDOW_SNAP_LEFT) {
+				edges = WLR_EDGE_LEFT | WLR_EDGE_TOP | WLR_EDGE_BOTTOM;
+			} else if (snap == WINDOW_SNAP_RIGHT) {
+				edges = WLR_EDGE_RIGHT | WLR_EDGE_TOP | WLR_EDGE_BOTTOM;
+			}
+			wlr_xdg_toplevel_set_tiled(toplevel, edges);
+		}
+		break;
+	}
+#if WLR_HAS_XWAYLAND
+	case SWAY_VIEW_XWAYLAND:
+		wlr_xwayland_surface_set_maximized(view->wlr_xwayland_surface, max, max);
+		break;
+#endif
+	}
+}
+
+// The whole geometry of a floating window (with title bar and border) like `resize set` + `move`.
+static void set_box(struct sway_container *con, const struct wlr_box *box) {
+	double dw = box->width - con->pending.width;
+	double dh = box->height - con->pending.height;
+	container_floating_move_to(con, box->x, box->y);
+	con->pending.width = box->width;
+	con->pending.height = box->height;
+	con->pending.content_width += dw;
+	con->pending.content_height += dh;
+	arrange_container(con);
+}
+
+static void snap_box(struct sway_workspace *ws, enum window_snap_side snap,
+		struct wlr_box *box) {
+	box->x = ws->x;
+	box->y = ws->y;
+	box->width = ws->width;
+	box->height = ws->height;
+	if (snap == WINDOW_SNAP_LEFT) {
+		box->width = ws->width / 2;
+	} else if (snap == WINDOW_SNAP_RIGHT) {
+		box->x += ws->width / 2;
+		box->width = ws->width - ws->width / 2;
+	}
+}
+
+static bool can_snap(struct sway_container *con) {
+	return con && container_is_floating(con) && con->pending.workspace &&
+		con->pending.fullscreen_mode == FULLSCREEN_NONE;
+}
+
+void window_snap(struct sway_container *con, enum window_snap_side snap,
+		const struct wlr_box *before) {
+	if (snap == WINDOW_SNAP_NONE) {
+		window_unsnap(con);
+		return;
+	}
+	if (!can_snap(con)) {
+		return;
+	}
+	struct sway_workspace *ws = con->pending.workspace;
+	if (con->actions.snap == WINDOW_SNAP_NONE) {
+		struct wlr_box now = {
+			.x = con->pending.x, .y = con->pending.y,
+			.width = con->pending.width, .height = con->pending.height,
+		};
+		const struct wlr_box *b = before ? before : &now;
+		con->actions.restore = (struct wlr_box){
+			.x = b->x - ws->x, .y = b->y - ws->y,
+			.width = b->width, .height = b->height,
+		};
+	}
+	con->actions.snap = snap;
+	struct wlr_box box;
+	snap_box(ws, snap, &box);
+	set_box(con, &box);
+	set_client_state(con, snap);
+	ipc_event_window(con, "move");
+}
+
+void window_unsnap(struct sway_container *con) {
+	if (!con || con->actions.snap == WINDOW_SNAP_NONE) {
+		return;
+	}
+	con->actions.snap = WINDOW_SNAP_NONE;
+	set_client_state(con, WINDOW_SNAP_NONE);
+	if (!can_snap(con)) {
+		return;
+	}
+	struct sway_workspace *ws = con->pending.workspace;
+	struct wlr_box box = con->actions.restore;
+	box.x += ws->x;
+	box.y += ws->y;
+	set_box(con, &box);
+	ipc_event_window(con, "move");
+}
+
+void window_toggle_maximize(struct sway_container *con) {
+	if (con && con->actions.snap == WINDOW_SNAP_MAX) {
+		window_unsnap(con);
+	} else {
+		window_snap(con, WINDOW_SNAP_MAX, NULL);
+	}
+}
+
+void window_set_maximized(struct sway_container *con, bool maximized) {
+	if (!con) {
+		return;
+	}
+	if (maximized && con->actions.snap != WINDOW_SNAP_MAX) {
+		window_snap(con, WINDOW_SNAP_MAX, NULL);
+	} else if (!maximized && con->actions.snap == WINDOW_SNAP_MAX) {
+		window_unsnap(con);
+	}
+}
+
+void window_fit_to_workspace(struct sway_container *con) {
+	if (!can_snap(con)) {
+		return;
+	}
+	struct sway_workspace *ws = con->pending.workspace;
+	struct wlr_box box = {
+		.x = con->pending.x, .y = con->pending.y,
+		.width = MIN((int)con->pending.width, ws->width),
+		.height = MIN((int)con->pending.height, ws->height),
+	};
+	box.x = MAX((int)ws->x, MIN(box.x, (int)ws->x + ws->width - box.width));
+	box.y = MAX((int)ws->y, MIN(box.y, (int)ws->y + ws->height - box.height));
+	if (box.x != con->pending.x || box.y != con->pending.y ||
+			box.width != con->pending.width || box.height != con->pending.height) {
+		set_box(con, &box);
+	}
+}
+
+void window_forget_snap(struct sway_container *con) {
+	if (con && con->actions.snap != WINDOW_SNAP_NONE) {
+		con->actions.snap = WINDOW_SNAP_NONE;
+		set_client_state(con, WINDOW_SNAP_NONE);
+	}
+}
+
+void window_unsnap_under_cursor(struct sway_container *con, double cx, double *dx) {
+	if (!con || con->actions.snap == WINDOW_SNAP_NONE || !can_snap(con)) {
+		return;
+	}
+	// the cursor stays at the same fraction of the title bar width, at the same height
+	double rel = con->pending.width > 0 ? (cx - con->pending.x) / con->pending.width : 0.5;
+	struct wlr_box box = con->actions.restore;
+	box.x = round(cx - rel * box.width);
+	box.y = con->pending.y;
+	con->actions.snap = WINDOW_SNAP_NONE;
+	set_client_state(con, WINDOW_SNAP_NONE);
+	set_box(con, &box);
+	*dx = cx - box.x;
+}
+
+enum window_snap_side window_snap_drag_target(double cx, double cy, struct wlr_box *box) {
+	struct wlr_output *wlr_output =
+		wlr_output_layout_output_at(root->output_layout, cx, cy);
+	if (!wlr_output || !wlr_output->data) {
+		return WINDOW_SNAP_NONE;
+	}
+	struct sway_output *output = wlr_output->data;
+	struct wlr_box out;
+	output_get_box(output, &out);
+	enum window_snap_side snap = WINDOW_SNAP_NONE;
+	if (cx <= out.x + EDGE) {
+		snap = WINDOW_SNAP_LEFT;
+	} else if (cx >= out.x + out.width - 1 - EDGE) {
+		snap = WINDOW_SNAP_RIGHT;
+	} else if (cy <= out.y + EDGE) {
+		snap = WINDOW_SNAP_MAX;
+	}
+	struct sway_workspace *ws = output_get_active_workspace(output);
+	if (snap == WINDOW_SNAP_NONE || !ws) {
+		return WINDOW_SNAP_NONE;
+	}
+	snap_box(ws, snap, box);
+	return snap;
+}
+
+// preview: a translucent fill in the active window's border colour and a 2 px outline
+static struct wlr_scene_tree *preview_tree = NULL;
+static struct wlr_scene_rect *preview_rects[5];
+
+void window_snap_preview(struct sway_container *con, const struct wlr_box *box) {
+	if (!box) {
+		if (preview_tree) {
+			wlr_scene_node_set_enabled(&preview_tree->node, false);
+		}
+		return;
+	}
+	if (!preview_tree) {
+		preview_tree = wlr_scene_tree_create(root->layers.floating);
+		if (!preview_tree) {
+			return;
+		}
+		const float none[4] = {0, 0, 0, 0};
+		for (int i = 0; i < 5; i++) {
+			preview_rects[i] = wlr_scene_rect_create(preview_tree, 0, 0, none);
+		}
+	}
+	const float *c = config->border_colors.focused.border;
+	// the scene wants premultiplied colours
+	const float fill[4] = {c[0] * 0.22f, c[1] * 0.22f, c[2] * 0.22f, 0.22f};
+	const float edge[4] = {c[0] * 0.9f, c[1] * 0.9f, c[2] * 0.9f, 0.9f};
+	int w = box->width, h = box->height, t = 2;
+	const struct wlr_box parts[5] = {
+		{0, 0, w, h}, {0, 0, w, t}, {0, h - t, w, t}, {0, t, t, h - 2 * t}, {w - t, t, t, h - 2 * t},
+	};
+	for (int i = 0; i < 5; i++) {
+		wlr_scene_rect_set_color(preview_rects[i], i == 0 ? fill : edge);
+		wlr_scene_rect_set_size(preview_rects[i], parts[i].width, parts[i].height);
+		wlr_scene_node_set_position(&preview_rects[i]->node, parts[i].x, parts[i].y);
+	}
+	wlr_scene_node_set_position(&preview_tree->node, box->x, box->y);
+	wlr_scene_node_set_enabled(&preview_tree->node, true);
+	// right under the dragged window (above the other floating windows)
+	if (con && con->scene_tree->node.parent == preview_tree->node.parent) {
+		wlr_scene_node_place_below(&preview_tree->node, &con->scene_tree->node);
+	} else {
+		wlr_scene_node_raise_to_top(&preview_tree->node);
+	}
+}
+
+void window_minimize(struct sway_container *con) {
+	if (!con) {
+		return;
+	}
+	if (container_is_floating_or_child(con)) {
+		while (con->pending.parent) {
+			con = con->pending.parent;
+		}
+	}
+	// a scratchpad window that is visible right now: just hide it
+	if (con->scratchpad) {
+		if (con->pending.workspace) {
+			root_scratchpad_hide(con);
+		}
+		return;
+	}
+	struct sway_workspace *ws = con->pending.workspace;
+	if (!ws) {
+		return;
+	}
+	free(con->actions.min_ws);
+	con->actions.min_ws = strdup(ws->name);
+	con->actions.min_tiled = !container_is_floating(con);
+	root_scratchpad_add_container(con, NULL);
+}
+
+void window_actions_destroy(struct sway_container *con) {
+	free(con->actions.min_ws);
+	con->actions.min_ws = NULL;
+}
