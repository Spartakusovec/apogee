+#ifndef _SWAY_CLOSE_NODE_H
+#define _SWAY_CLOSE_NODE_H
+#include <stdbool.h>
+#include <wlr/types/wlr_scene.h>
+
+enum sway_title_button {
+	TITLE_BUTTON_NONE,
+	TITLE_BUTTON_CLOSE,
+	TITLE_BUTTON_MAXIMIZE,
+	TITLE_BUTTON_RESTORE, // maximized window: restore the original size
+	TITLE_BUTTON_MINIMIZE,
+};
+
+// A button in a window's title bar (a circle with a symbol: ✕, □, two squares, _).
+struct sway_close_node {
+	enum sway_title_button type;
+	int size; // circle diameter in logical pixels
+	bool hover;
+	float color[4];      // colour of the ✕ and the circle (like the title text)
+	float background[4]; // title bar background
+
+	struct wlr_scene_node *node;
+};
+
+struct sway_close_node *sway_close_node_create(struct wlr_scene_tree *parent,
+		enum sway_title_button type, int size, float color[4], float background[4]);
+
+void sway_close_node_set_type(struct sway_close_node *node, enum sway_title_button type);
+
+void sway_close_node_set_size(struct sway_close_node *node, int size);
+
+void sway_close_node_set_colors(struct sway_close_node *node,
+		float color[4], float background[4]);
+
+void sway_close_node_set_hover(struct sway_close_node *node, bool hover);
+
+#endif
