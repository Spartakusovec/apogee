diff --git a/include/sway/window_actions.h b/include/sway/window_actions.h
new file mode 100644
index 0000000..f9cbb54
--- /dev/null
+++ b/include/sway/window_actions.h
@@ -0,0 +1,58 @@
+#ifndef _SWAY_KRIZEK_H
+#define _SWAY_KRIZEK_H
+#include <stdbool.h>
+#include <stdint.h>
+#include <wlr/util/box.h>
+
+// window-actions: maximize, edge snapping and minimize for floating windows.
+
+struct sway_container;
+
+enum window_snap_side {
+	WINDOW_SNAP_NONE,
+	WINDOW_SNAP_MAX,   // the whole workspace
+	WINDOW_SNAP_LEFT,  // left half
+	WINDOW_SNAP_RIGHT, // right half
+};
+
+struct window_actions_state {
+	enum window_snap_side snap;
+	struct wlr_box restore; // geometry before maximizing / snapping (x, y relative to the workspace)
+	char *min_ws;           // minimized window: the workspace it returns to (NULL = plain scratchpad)
+	bool min_tiled;         // the minimized window was tiled
+};
+
+#define WINDOW_ACTIONS_DOUBLE_CLICK_MS 400
+
+/** Maximize / snap a floating window; `before` = the geometry to return to (NULL = the current one). */
+void window_snap(struct sway_container *con, enum window_snap_side snap,
+		const struct wlr_box *before);
+
+/** Return a maximized / snapped window to its original size and place. */
+void window_unsnap(struct sway_container *con);
+
+void window_toggle_maximize(struct sway_container *con);
+
+void window_set_maximized(struct sway_container *con, bool maximized);
+
+/** A new floating window: if it's bigger than the workspace or sticks out of it, fit it in. */
+void window_fit_to_workspace(struct sway_container *con);
+
+/** The window is being resized by hand: it's no longer maximized / snapped (the geometry stays). */
+void window_forget_snap(struct sway_container *con);
+
+/** A snapped window is being dragged: give it back its original size with the title bar under the cursor. */
+void window_unsnap_under_cursor(struct sway_container *con, double cx, double *dx);
+
+/** Where the window lands if released with the cursor at [cx, cy]; puts the target geometry into `box`. */
+enum window_snap_side window_snap_drag_target(double cx, double cy, struct wlr_box *box);
+
+/** Snap preview under the dragged window (box NULL = hide). */
+void window_snap_preview(struct sway_container *con, const struct wlr_box *box);
+
+/** Minimize a window (to the scratchpad; the dock and Alt+Tab return it to its workspace). */
+void window_minimize(struct sway_container *con);
+
+void window_actions_destroy(struct sway_container *con);
+
+#endif
