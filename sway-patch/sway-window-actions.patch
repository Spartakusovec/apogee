+
+enum sway_title_button container_title_button_at(struct sway_container *con,
+		double lx, double ly) {
+	if (!con->title_bar.tree->node.enabled) {
+		return TITLE_BUTTON_NONE;
+	}
+	struct sway_close_node *buttons[] = {
+		con->title_bar.close_button, con->title_bar.max_button, con->title_bar.min_button,
+	};
+	for (size_t i = 0; i < sizeof(buttons) / sizeof(buttons[0]); i++) {
+		struct sway_close_node *b = buttons[i];
+		int x, y;
+		if (!b || !b->node->enabled || !wlr_scene_node_coords(b->node, &x, &y)) {
+			continue;
+		}
+		// the whole square as tall as the title bar is clickable, not just the circle
+		int margin = ((int)container_titlebar_height() - b->size) / 2;
+		if (lx >= x - margin && lx < x + b->size + margin &&
+				ly >= y - margin && ly < y + b->size + margin) {
+			return b->type;
+		}
+	}
+	return TITLE_BUTTON_NONE;
+}
+
+static size_t hover_id = 0;
+static enum sway_title_button hover_button = TITLE_BUTTON_NONE;
+
+static bool find_by_id(struct sway_container *con, void *data) {
+	return con->node.id == *(size_t *)data;
+}
+
+static struct sway_close_node *button_of(struct sway_container *con,
+		enum sway_title_button button) {
+	switch (button) {
+	case TITLE_BUTTON_CLOSE:
+		return con->title_bar.close_button;
+	case TITLE_BUTTON_MAXIMIZE:
+	case TITLE_BUTTON_RESTORE:
+		return con->title_bar.max_button;
+	case TITLE_BUTTON_MINIMIZE:
+		return con->title_bar.min_button;
+	case TITLE_BUTTON_NONE:
+		break;
+	}
+	return NULL;
+}
+
+void container_title_button_hover(struct sway_container *con,
+		enum sway_title_button button) {
+	size_t id = con && button != TITLE_BUTTON_NONE ? con->node.id : 0;
+	if (id == hover_id && button == hover_button) {
+		return;
+	}
+	if (hover_id) {
+		struct sway_container *old = root_find_container(find_by_id, &hover_id);
+		struct sway_close_node *b = old ? button_of(old, hover_button) : NULL;
+		if (b) {
+			sway_close_node_set_hover(b, false);
+		}
+	}
+	hover_id = id;
+	hover_button = id ? button : TITLE_BUTTON_NONE;
+	struct sway_close_node *b = id ? button_of(con, button) : NULL;
+	if (b) {
+		sway_close_node_set_hover(b, true);
+	}
+}
