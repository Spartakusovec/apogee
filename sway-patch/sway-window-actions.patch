diff --git a/sway/commands/window_actions.c b/sway/commands/window_actions.c
new file mode 100644
index 0000000..aa677b4
--- /dev/null
+++ b/sway/commands/window_actions.c
@@ -0,0 +1,75 @@
+// window-actions: the commands `maximize [enable|disable|toggle]`, `minimize` and `snap left|right`
+// (keys Super+↑ / ↓ / ← / →, the window menu and the dock in Apogee).
+#include <strings.h>
+#include "sway/commands.h"
+#include "sway/window_actions.h"
+#include "sway/tree/container.h"
+
+struct cmd_results *cmd_maximize(int argc, char **argv) {
+	struct sway_container *con = config->handler_context.container;
+	if (!con) {
+		return cmd_results_new(CMD_INVALID, "Only windows can be maximized");
+	}
+	if (container_is_floating_or_child(con)) {
+		con = container_toplevel_ancestor(con);
+	}
+	if (!container_is_floating(con)) {
+		return cmd_results_new(CMD_SUCCESS, NULL); // tiled: nothing
+	}
+	const char *akce = argc > 0 ? argv[0] : "toggle";
+	if (strcasecmp(akce, "enable") == 0) {
+		window_set_maximized(con, true);
+	} else if (strcasecmp(akce, "disable") == 0) {
+		// also restores a window snapped to half the screen
+		window_unsnap(con);
+	} else if (strcasecmp(akce, "toggle") == 0) {
+		window_toggle_maximize(con);
+	} else {
+		return cmd_results_new(CMD_INVALID, "Expected 'maximize [enable|disable|toggle]'");
+	}
+	return cmd_results_new(CMD_SUCCESS, NULL);
+}
+
+struct cmd_results *cmd_minimize(int argc, char **argv) {
+	struct sway_container *con = config->handler_context.container;
+	if (!con || !con->view) {
+		return cmd_results_new(CMD_INVALID, "Only windows can be minimized");
+	}
+	window_minimize(con);
+	return cmd_results_new(CMD_SUCCESS, NULL);
+}
+
+/**
+ * snap left|right (Super+← / Super+→): a floating window to half the screen; from the opposite half
+ * back to the original size (like Windows). When tiled, or with no window, the same as before:
+ * moving the focus (focus left / right).
+ */
+struct cmd_results *cmd_snap(int argc, char **argv) {
+	if (argc < 1) {
+		return cmd_results_new(CMD_INVALID, "Expected 'snap left|right'");
+	}
+	enum window_snap_side side;
+	if (strcasecmp(argv[0], "left") == 0) {
+		side = WINDOW_SNAP_LEFT;
+	} else if (strcasecmp(argv[0], "right") == 0) {
+		side = WINDOW_SNAP_RIGHT;
+	} else {
+		return cmd_results_new(CMD_INVALID, "Expected 'snap left|right'");
+	}
+	struct sway_container *con = config->handler_context.container;
+	if (con && container_is_floating_or_child(con)) {
+		con = container_toplevel_ancestor(con);
+	}
+	if (!con || !container_is_floating(con) ||
+			con->pending.fullscreen_mode != FULLSCREEN_NONE) {
+		char *focus_argv[] = { argv[0] };
+		return cmd_focus(1, focus_argv);
+	}
+	enum window_snap_side opposite = side == WINDOW_SNAP_LEFT ? WINDOW_SNAP_RIGHT : WINDOW_SNAP_LEFT;
+	if (con->actions.snap == opposite) {
+		window_unsnap(con);
+	} else if (con->actions.snap != side) {
+		window_snap(con, side, NULL);
+	}
+	return cmd_results_new(CMD_SUCCESS, NULL);
+}
